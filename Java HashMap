import java.util.*;

class Student {
    int id;
    String name;

    Student(int id, String name) {
        this.id = id;
        this.name = name;
    }

    // Override equals()
    @Override
    public boolean equals(Object o) {
        if (this == o) return true; //these 2 lines only checks type of object
        if (o == null || getClass() != o.getClass()) return false;
    
        Student s = (Student) o;
        return this.id == s.id && this.name.equals(s.name); //Here object Equality is checked
    }

    // Override hashCode()
    @Override
    public int hashCode() {
        return id; // simple hash based on id -> Decides the object bucket position in hashset
    }
}

public class Main {
    public static void main(String[] args) {
        HashSet<Student> set = new HashSet<>();

        Student s1 = new Student(1, "Sandeep");
        Student s2 = new Student(1, "Sand");

        set.add(s1);
        set.add(s2);

        System.out.println(set.size()); // Output: 1
    }
}

// Output = 2
