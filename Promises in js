function wait(ms) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            resolve("Done waiting!");
        }, ms);
    });
}

// Using the promise
wait(2000).then((message) => {
    console.log(message); // prints after 2 seconds
});

// output -> Done waiting! after 2000ms

