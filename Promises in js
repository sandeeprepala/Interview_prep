function checkResult(marks) {
    return new Promise((resolve, reject) => {
        if (marks >= 40) {
            resolve("You passed!");
        } else {
            reject("You failed!");
        }
    });
}

// Using the promise
checkResult(55)
    .then((message) => {
        console.log(message);
    })
    .catch((error) => {
        console.log(error);
    });


// output -> You passed!
